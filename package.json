{
  "name": "roleharbour",
  "version": "0.22.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "On-device job research companion for SEEK New Zealand",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "catalog:import": "node --experimental-strip-types scripts/import-occupations.ts",
    "catalog:synonyms": "node --experimental-strip-types scripts/import-occupation-synonyms.ts",
    "catalog:software": "node --experimental-strip-types scripts/import-software-skills.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "postinstall": "wxt prepare",
    "format": "prettier --write src entrypoints data scripts tests public docs site README.md CHANGELOG.md .github *.ts *.json *.yaml",
    "format:check": "prettier --check src entrypoints data scripts tests public docs site README.md CHANGELOG.md .github *.ts *.json *.yaml",
    "test:release": "python3 -m unittest discover -s tests -p '*_test.py'",
    "release:prepare": "python3 scripts/prepare-release.py",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "marked": "^18.1.2",
    "prettier": "^3.9.10",
    "read-excel-file": "^9.3.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.0.6"
}
